# Integration Test Credentials
# Copy this file to .env and fill in real values from your Checkmarx One tenant
# DO NOT COMMIT .env to git — it will be ignored by .gitignore

# Checkmarx One API Key (personal access token or service account key)
# Format: API key from https://deu.ast.checkmarx.net/auth/api-tokens
CX_API_KEY=your-api-key-here

# Test Project ID (UUID of an existing project in your tenant)
# Example: c1766-b940-471f-a5f8-d948fd9d
CX_TEST_PROJECT_ID=your-test-project-id-here

# Test Branch Name (a branch that has completed scans in CX_TEST_PROJECT_ID)
# Integration tests will use scans from this branch to test result retrieval
# Example: main
CX_TEST_BRANCH=your-test-branch-here

# Test Scan ID (UUID of a completed scan in the above project/branch)
# Integration tests use this scan to verify result operations, triage, etc.
# Example: 0ae20acf-1bc6-4f52-9c47-21ec00b7c1b0
CX_TEST_SCAN_ID=your-test-scan-id-here
